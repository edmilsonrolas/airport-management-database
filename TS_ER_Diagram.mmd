
erDiagram
    AIRCRAFT {
        int aircraft_id PK
        string registration UK
        string model
        int capacity
        string status
        decimal flight_hours
    }

    FLIGHT {
        int flight_id PK
        string flight_number
        string origin
        string destination
        datetime scheduled_departure
        datetime scheduled_arrival
        int flight_capacity
        datetime checkin_opening
        datetime checkin_closing
        string status
        int aircraft_id FK
    }

    PASSENGER {
        int passenger_id PK
        string full_name
        string identification_document UK
        date date_of_birth
        string nationality
        string contact
    }

    BOOKING {
        int booking_id PK
        datetime booking_date
        string status
        int passenger_id FK
        int flight_id FK
    }

    CHECK_IN {
        int checkin_id PK
        datetime checkin_datetime
        string status
        int passenger_id FK
        int flight_id FK
    }

    RUNWAY {
        int runway_id PK
        string code UK
        int length
        string status
    }

    RUNWAY_OPERATION {
        int operation_id PK
        int runway_id FK
        int flight_id FK
        datetime start_datetime
        datetime end_datetime
        string operation_type
        string status
    }

    GATE {
        int gate_id PK
        string code UK
        string terminal
        string status
    }

    GATE_ALLOCATION {
        int allocation_id PK
        int flight_id FK
        int gate_id FK
        datetime start_datetime
        datetime end_datetime
        string status
    }

    MAINTENANCE {
        int maintenance_id PK
        int aircraft_id FK
        string maintenance_type
        datetime start_datetime
        datetime end_datetime
        string status
        string description
    }

    RESCHEDULING {
        int rescheduling_id PK
        int flight_id FK
        datetime rescheduling_datetime
        string reason
        datetime previous_departure
        datetime previous_arrival
        datetime new_departure
        datetime new_arrival
    }

    AIRCRAFT ||--o{ FLIGHT : "is assigned to"
    AIRCRAFT ||--o{ MAINTENANCE : "has"
    BOOKING }o--|| PASSENGER : "makes"
    FLIGHT ||--o{ BOOKING : "receives"
    CHECK_IN }o--|| PASSENGER : "completes"
    FLIGHT ||--o{ CHECK_IN : "records"
    FLIGHT ||--o{ GATE_ALLOCATION : "has"
    GATE_ALLOCATION }o--|| GATE : "is assigned through"
    FLIGHT ||--o{ RUNWAY_OPERATION : "includes"
    RUNWAY_OPERATION }o--|| RUNWAY : "is used in"
    FLIGHT ||--o{ RESCHEDULING : "has history"


