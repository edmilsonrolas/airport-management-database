
erDiagram
    AIRPORT {
        int airport_id PK
        string iata_code UK
        string icao_code UK
        string name
        string city
        string country
    }

    AIRCRAFT {
        int aircraft_id PK
        string registration UK
        string model
        int capacity
        string status
        decimal flight_hours
    }

    FLIGHT {
        int flight_id PK
        string flight_number
        int origin_airport_id FK
        int destination_airport_id FK
        datetime scheduled_departure
        datetime scheduled_arrival
        int flight_capacity
        datetime checkin_opening
        datetime checkin_closing
        string status
    }

    AIRCRAFT_ASSIGNMENT {
        int assignment_id PK
        int flight_id FK
        int aircraft_id FK
        datetime start_datetime
        datetime end_datetime
        string status
    }

    PASSENGER {
        int passenger_id PK
        string full_name
        string identification_document UK
        date date_of_birth
        string nationality
        string contact
    }

    BOOKING {
        int booking_id PK
        datetime booking_date
        string status
        int passenger_id FK
        int flight_id FK
    }

    BOOKING_STATUS_HISTORY {
        int history_id PK
        int booking_id FK
        string previous_status
        string new_status
        datetime changed_at
        string reason
    }

    CHECK_IN {
        int checkin_id PK
        int booking_id FK
        datetime checkin_datetime
        string status
    }

    RUNWAY {
        int runway_id PK
        int airport_id FK
        string code
        int length
        string status
    }

    RUNWAY_OPERATION {
        int operation_id PK
        int runway_id FK
        int flight_id FK
        datetime start_datetime
        datetime end_datetime
        string operation_type
        string status
    }

    GATE {
        int gate_id PK
        int airport_id FK
        string code
        string terminal
        string status
    }

    GATE_ALLOCATION {
        int allocation_id PK
        int flight_id FK
        int gate_id FK
        string allocation_type
        datetime start_datetime
        datetime end_datetime
        string status
    }

    AIRCRAFT_STAND {
        int stand_id PK
        int airport_id FK
        string code
        string stand_type
        string status
    }

    STAND_ALLOCATION {
        int stand_allocation_id PK
        int flight_id FK
        int stand_id FK
        datetime start_datetime
        datetime end_datetime
        string status
    }

    MAINTENANCE {
        int maintenance_id PK
        int aircraft_id FK
        string maintenance_type
        datetime start_datetime
        datetime end_datetime
        string status
        string description
    }

    RESCHEDULING {
        int rescheduling_id PK
        int flight_id FK
        datetime rescheduling_datetime
        string reason
        datetime previous_departure
        datetime previous_arrival
        datetime new_departure
        datetime new_arrival
    }

    RESCHEDULING_RESOURCE_CHANGE {
        int change_id PK
        int rescheduling_id FK
        string resource_type
        int previous_aircraft_id FK
        int new_aircraft_id FK
        int previous_gate_id FK
        int new_gate_id FK
        int previous_runway_id FK
        int new_runway_id FK
        int previous_stand_id FK
        int new_stand_id FK
    }

    AIRPORT ||--o{ FLIGHT : "is origin for"
    AIRPORT ||--o{ FLIGHT : "is destination for"
    AIRPORT ||--o{ RUNWAY : "has"
    AIRPORT ||--o{ GATE : "has"
    AIRPORT ||--o{ AIRCRAFT_STAND : "has"

    FLIGHT ||--o{ AIRCRAFT_ASSIGNMENT : "has assignment history"
    AIRCRAFT ||--o{ MAINTENANCE : "undergoes"
    AIRCRAFT ||--o{ AIRCRAFT_ASSIGNMENT : "is assigned through"

    FLIGHT ||--o{ RESCHEDULING : "has history"
    RESCHEDULING ||--o{ RESCHEDULING_RESOURCE_CHANGE : "records"

    PASSENGER ||--o{ BOOKING : "makes"
    FLIGHT ||--o{ BOOKING : "receives"

    BOOKING ||--o{ BOOKING_STATUS_HISTORY : "has status history"
    BOOKING ||--o| CHECK_IN : "may have"

    GATE_ALLOCATION }o--|| FLIGHT : "has"
    GATE ||--o{ GATE_ALLOCATION : "is allocated through"

    RUNWAY_OPERATION }o--|| FLIGHT : "includes"
    RUNWAY ||--o{ RUNWAY_OPERATION : "is used in"
    
    STAND_ALLOCATION }o--|| FLIGHT : "has"
    AIRCRAFT_STAND ||--o{ STAND_ALLOCATION : "is allocated through"

    
